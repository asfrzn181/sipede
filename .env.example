# ==============================================================================
# SIPEDE (Sistem Informasi Anggaran Dinas DPRD) - Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env di server hosting / lokal dan sesuaikan isinya.
# JANGAN PERNAH meng-commit file .env yang berisi password ke GitHub!
# ==============================================================================

# Mode aplikasi: production (untuk cPanel) atau development (untuk lokal)
CI_ENV=production

# Nama aplikasi & URL Dasar
APP_NAME="Sistem Informasi Perjalanan Dinas DPRD"
# Jika di cPanel (root domain): https://sipede.domainanda.com/
# Jika di cPanel (subfolder):   https://domainanda.com/sipede/
APP_BASE_URL=https://sipede.domainanda.com/
APP_INDEX_PAGE=
APP_COOKIE_SECURE=1

# Konfigurasi Database cPanel MySQL
# (Buat database dan user di cPanel menu 'MySQL Databases')
DB_HOST=localhost
DB_NAME=usfd6ds0_sipede
DB_USER=cpaneluser_dbuser
DB_PASS=PasswordDatabaseKuatAnda123!

# Kunci Enkripsi (acak minimal 32 karakter untuk primary key url encryption)
ENCRYPTION_KEY=sipede-dprd-kunci-enkripsi-sangat-rahasia-2026

# Mode Saldo: PERINGATAN (boleh ajukan dengan notifikasi) / KETAT (tolak jika saldo minus)
MODE_SALDO=PERINGATAN
